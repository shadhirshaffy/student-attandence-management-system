# Reference only: Spring Boot does not automatically load .env files.
# Set these in your terminal or IDE. Never commit a populated .env.
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/attendance_db
DATABASE_USERNAME=attendance_app
DATABASE_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080
FRONTEND_BASE_URL=http://localhost:5173
ATTENDANCE_LOW_THRESHOLD=80
APP_SEED_ENABLED=false
JPA_DDL_AUTO=update
